# GitGuardian personal access token, scope: scan:create-incidents
# Dashboard > API > Personal access tokens (US SaaS:
# https://dashboard.gitguardian.com/api/personal-access-tokens)
GITGUARDIAN_API_KEY=

# Optional: GitGuardian API URL. Defaults to the US SaaS API; set it for
# other regions or self-hosted instances:
#   EU SaaS:     https://api.eu1.gitguardian.com
#   Self-hosted: https://<your-instance>/exposed
# GITGUARDIAN_API_URL=https://api.gitguardian.com

# UUID of the GitGuardian custom source incidents are raised on (Dashboard >
# Integrations > Custom source), e.g. one named "github.com/<org> Issues & PRs".
GITGUARDIAN_SOURCE_UUID=

# Webhook receiver: the secret configured on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=

# Backfill: a token with read access to the repository's issues and pull
# requests (a fine-grained token with "Issues: read" and "Pull requests: read").
# Optional for the webhook receiver, which uses it to look up authors' public emails.
GITHUB_TOKEN=

# Optional: GitHub Enterprise Server API URL.
# GITHUB_API_URL=https://github.example.com/api/v3
