# GitGuardian personal access token, scope: scan (plus scan:create-incidents
# if GITGUARDIAN_SOURCE_UUID is set)
# https://dashboard.gitguardian.com/api/personal-access-tokens
GITGUARDIAN_API_KEY=

# Optional: GitGuardian API URL. Defaults to the US SaaS API; set it for
# other regions or self-hosted instances:
#   EU SaaS:     https://api.eu1.gitguardian.com
#   Self-hosted: https://<your-instance>/exposed
# GITGUARDIAN_API_URL=https://api.gitguardian.com

# Optional: UUID of a GitGuardian custom source (Dashboard > Integrations >
# Custom source). When set, every detected secret also creates a real
# GitGuardian incident via /v1/scan/create-incidents. Leave unset to only
# block on detection without creating incidents.
# GITGUARDIAN_SOURCE_UUID=

# Real upstream LLM providers. Set whichever one(s) you want to call - the
# client picks a provider per-request via a "openai/<model>",
# "anthropic/<model>", or "mistral/<model>" prefix on the model name, so all
# three keys can be set at once. At least one is required; there is no mock
# mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
